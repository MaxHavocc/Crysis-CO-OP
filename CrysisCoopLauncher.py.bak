        except Exception:
            pass

        cfg_paths = [
            os.path.join(CRYSIS_ROOT_DIR, "client.cfg"),
            os.path.join(CRYSIS_ROOT_DIR, "Game", "client.cfg"),
            os.path.join(CRYSIS_MOD_DIR, "client.cfg"),
            os.path.join(CRYSIS_MOD_DIR, "Game", "client.cfg"),
        ]
        for p in cfg_paths:
            try:
                os.makedirs(os.path.dirname(p), exist_ok=True)
                with open(p, "w", encoding="utf-8") as f:
                    f.write(cfg_content)
            except Exception as e:
                self.log_msg(f"Notice: Failed to write {p}: {e}")

        exe_path = os.path.join(CRYSIS_ROOT_DIR, "Bin32", "Crysis.exe")
        args = [exe_path, "-dx9", "-mod", "CrysisCoop", "-DEVMODE", "-windowed", "+sys_spec", "1", "+exec", "client.cfg"]
        self.log_msg(f"Launching Crysis Client process as '{callsign}'...")
        try:
            subprocess.Popen(args, cwd=CRYSIS_ROOT_DIR)
            self.log_msg("Crysis Client process started.")
        except Exception as e:
            self.log_msg(f"Failed to launch Crysis.exe: {e}")

    # =========================================================================
    # 6. SAVED GAMES PANEL
    # =========================================================================
    def build_saves_panel(self):
        card = tk.Frame(self.panel_saves, bg=CrysisTheme.BG_PANEL,
                        highlightthickness=1, highlightbackground=CrysisTheme.BORDER_SUBTLE)
        card.pack(fill="both", expand=True)

        tk.Label(card, text="SAVED GAMES", font=(CrysisTheme.FONT_TITLE, 13, "bold"),
                 fg=CrysisTheme.TEXT_TITLE, bg=CrysisTheme.BG_PANEL).pack(anchor="w", padx=24, pady=(20, 12))

        self.list_saves = tk.Listbox(card, bg=CrysisTheme.BG_INPUT, fg=CrysisTheme.TEXT_NORMAL,
                                     font=(CrysisTheme.FONT_UI, 9), bd=0, highlightthickness=1,
                                     highlightbackground=CrysisTheme.BORDER_SUBTLE,
                                     selectbackground=CrysisTheme.BG_HOVER, selectforeground=CrysisTheme.CYAN_ACCENT)
        self.list_saves.pack(fill="both", expand=True, padx=24, pady=(0, 16))

        row = tk.Frame(card, bg=CrysisTheme.BG_PANEL)
        row.pack(fill="x", padx=24, pady=(0, 20))

        btn_load = tk.Button(row, text="›  Load Save to Host", font=(CrysisTheme.FONT_UI, 10, "bold"),
                             fg=CrysisTheme.TEXT_TITLE, bg=CrysisTheme.BG_HOVER, bd=1, relief="solid",
                             highlightthickness=1, highlightbackground=CrysisTheme.BORDER_SUBTLE,
                             padx=16, pady=6, cursor="hand2", command=self.load_selected_save)
        btn_load.pack(side="left")

    def refresh_saves(self):
        self.list_saves.delete(0, "end")
        if not os.path.exists(SAVES_DIR):
            return
        files = [f for f in os.listdir(SAVES_DIR) if f.endswith(".json")]
        if not files:
            self.list_saves.insert("end", "  No saved games found.")
            return
        for f in files:
            try:
                with open(os.path.join(SAVES_DIR, f), "r") as fp:
                    data = json.load(fp)
                mission = data.get("mission", "Unknown")
                ts = data.get("timestamp", "")
                players = list(data.get("players", {}).keys())
                self.list_saves.insert("end", f"  {f}  |  Mission: {mission}  |  Time: {ts}  |  Players: {', '.join(players)}")
            except:
                self.list_saves.insert("end", f"  {f} (Corrupted)")

    def load_selected_save(self):
        sel = self.list_saves.curselection()
        if not sel:
            messagebox.showinfo("Select Save", "Please select a save game from the list.")
            return
        text = self.list_saves.get(sel[0]).strip()
        fname = text.split("|")[0].strip()
        fpath = os.path.join(SAVES_DIR, fname)
        if os.path.exists(fpath):
            with open(fpath, "r") as fp:
                data = json.load(fp)
            mission = data.get("mission", "island")
            diff = data.get("difficulty", 2)
            for m_name, m_code in MISSIONS:
                if m_code == mission:
                    self.mission_var.set(m_name)
                    break
            for d_name, d_val in DIFFICULTIES:
                if d_val == diff:
                    self.diff_var.set(d_name)
                    break
            self.show_create_view()
            self.log_msg(f"Loaded save: {fname}")
            messagebox.showinfo("Save Loaded", f"Save '{fname}' loaded!\nMission: {mission}\nReady to host.")

if __name__ == "__main__":
    app = CrysisCoopLauncher()
    app.mainloop()
